<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE sqlMapConfig PUBLIC "-//ibatis.apache.org//DTD SQL Map Config 2.0//EN" "http://ibatis.apache.org/dtd/sql-map-config-2.dtd">
<sqlMapConfig>
    <settings cacheModelsEnabled="true" enhancementEnabled="true" lazyLoadingEnabled="true" />

    <typeAlias alias="UserVO" type="model.UserVo"/>

    <transactionManager type="JDBC">
        <dataSource type="SIMPLE">
            <property name="JDBC.Driver" value="com.mysql.jdbc.Driver"/>
            <property name="JDBC.ConnectionURL" value="jdbc:mysql://localhost:3306/mem"/>
            <property name="JDBC.Username" value="root"/>
            <property name="JDBC.Password" value="qwer1234"/>
        </dataSource>
    </transactionManager>

   	<sqlMap resource="map/user-mapping.xml"/>
</sqlMapConfig>
